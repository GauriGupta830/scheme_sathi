# ─────────────────────────────────────────────────────────────
#  Scheme Saathi — optional settings
#
#  YOU DO NOT NEED THIS FILE TO RUN THE APP.
#  Everything works offline without any API key.
#
#  Only if you want Gemini to make the wording warmer:
#    1. copy this file and rename the copy to  .env
#    2. paste your key below
#    3. restart the app
#  Free key: https://aistudio.google.com/apikey
# ─────────────────────────────────────────────────────────────

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Change only if port 8000 is busy on your machine
HOST=0.0.0.0
PORT=8000
